# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# All providers below have a free tier. No credit card required for any of them.

# ---- LLM (extraction, script writing, entailment) ----
# gpt-oss-120b served by Groq — OpenAI-compatible endpoint.
# Key: https://console.groq.com -> API Keys -> Create API Key
LLM_PROVIDER=mock                                   # mock | gpt_oss
GPT_OSS_API_KEY=
GPT_OSS_BASE_URL=https://api.groq.com/openai/v1
GPT_OSS_MODEL=openai/gpt-oss-120b

# ---- Translation (chain order = fallback order) ----
# Sarvam: https://dashboard.sarvam.ai -> API Keys
TRANSLATION_PROVIDERS=mock                          # sarvam,gemini
SARVAM_API_KEY=

# ---- TTS (must return per-scene timings — captions depend on them) ----
TTS_PROVIDERS=mock                                  # sarvam_tts,gemini_tts
# sarvam_tts reuses SARVAM_API_KEY above
# gemini_tts reuses GEMINI_API_KEY below

# ---- Visuals (generate -> stock search -> title card, in that order) ----
VISUAL_PROVIDERS=mock                               # nano_banana,stock,title_card
# nano_banana reuses GEMINI_API_KEY below
# Pexels: https://www.pexels.com/api -> Your API Key
PEXELS_API_KEY=

# ---- Google AI Studio (Gemini: TTS + image gen + translation fallback) ----
# Key: https://aistudio.google.com -> Get API Key -> Create API key
GEMINI_API_KEY=

# ---- Embeddings (verifier retrieval) ----
# Local sentence-transformers model — no API key, no cost.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ---- Supabase (Postgres + pgvector + storage) ----
# https://supabase.com/dashboard -> New project
# DATABASE_URL:        Settings -> Database -> Connection string -> URI
# SUPABASE_URL / KEY:  Settings -> API  (use the service_role key, server-side only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaanireach
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Infra ----
REDIS_URL=redis://localhost:6379/0
OUTPUT_ROOT=output

# ---- Pipeline ----
DEFAULT_LANGUAGES=hi,mr,ta
MAX_REPAIR_ATTEMPTS=3
